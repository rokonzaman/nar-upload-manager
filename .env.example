# ============================================================================
# NiFi NAR Manager — configuration
# Copy to .env and adjust. All backend settings are read from these variables.
# ============================================================================

# --- Application -----------------------------------------------------------
APP_NAME=NiFi NAR Manager
APP_VERSION=1.0.0
DEBUG=false
# REQUIRED in production: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret-key
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Frontend: URL the browser uses to reach the backend. Set per-environment at
# deploy time — no rebuild needed. Also passed to the frontend at container runtime.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Database --------------------------------------------------------------
DATABASE_URL=sqlite:///./nar_manager.db
# PostgreSQL alternative (docker compose --profile postgres up):
# DATABASE_URL=postgresql://narmgr:narmgr@localhost:5432/nar_manager

# --- Authentication ----------------------------------------------------------
# Dev mode: local users (admin/admin123 after seeding). DISABLE in production.
AUTH_DEV_MODE=true
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_RATE_LIMIT_PER_MINUTE=20

# Keycloak OIDC (docker compose --profile sso up starts Keycloak with the
# nar-manager realm pre-imported, see docs/keycloak-realm.json)
KEYCLOAK_ENABLED=false
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=nar-manager
KEYCLOAK_CLIENT_ID=nar-manager-frontend
KEYCLOAK_CLIENT_SECRET=nar-manager-secret

# Role management -----------------------------------------------------------
# false (default): Keycloak handles sign-in ONLY; roles are managed in the app
#   (Settings → Users). New SSO users get DEFAULT_USER_ROLE.
# true: roles are synced from Keycloak realm roles (nar-admin / nar-developer /
#   nar-viewer) on every login.
KEYCLOAK_ROLE_SYNC_ENABLED=false
DEFAULT_USER_ROLE=viewer
# Comma-separated usernames that always get admin at login — use this to
# bootstrap your first administrator when roles are app-managed.
ADMIN_USERNAMES=admin

# --- NAR storage -------------------------------------------------------------
NAR_DIRECTORY=./nar_files
BACKUP_DIRECTORY=./backup
# Max upload size in bytes (default 1 GiB)
MAX_UPLOAD_SIZE=1073741824
ALLOWED_EXTENSIONS=.nar

# --- SSH ---------------------------------------------------------------------
SSH_TIMEOUT=30

# --- Scheduler (retention + nexus sync cron jobs) ----------------------------
SCHEDULER_ENABLED=true

# --- Nexus (default connection; additional servers managed via UI) ----------
NEXUS_URL=http://localhost:8081
NEXUS_USERNAME=admin
NEXUS_PASSWORD=admin123
NEXUS_REPOSITORY=nar-releases

# --- Retention policy (seeded defaults; managed via UI afterwards) ---------
RETENTION_ENABLED=true
RETENTION_KEEP_LATEST=5
RETENTION_KEEP_DAYS=90
RETENTION_DRY_RUN=false
RETENTION_SCHEDULE=0 0 * * 0

# --- Email notifications (SMTP) ----------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=nar-manager@localhost
SMTP_TLS=true

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=./logs/nar-manager.log

# --- NiFi integration (defaults; per-server config lives in the DB) --------
NIFI_URL=http://localhost:8443
NIFI_API_URL=http://localhost:8443/nifi-api
NIFI_USERNAME=admin
NIFI_PASSWORD=admin123
NIFI_ENABLED=false

# --- Multi-server environments ------------------------------------------------
ENVIRONMENTS=DEV,QA,PROD
